# Disable directory listing
Options -Indexes

# Custom Error Pages routed through index.php so Debug Mode (Off vs On) is respected for all public errors
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
ErrorDocument 500 /index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct HTTP access to all internal/private directories
    RewriteRule ^(includes|data|backups|temp|database)(/|$) - [F,L,NC]

    # 2. Block direct HTTP access to hidden dot-files (except .well-known for SSL verification)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # 3. Clean URLs for Public Button Pages: /p/my-slug -> view.php?slug=my-slug
    RewriteRule ^p/([a-zA-Z0-9_-]+)/?$ view.php?slug=$1 [L,QSA]
    RewriteRule ^page/([a-zA-Z0-9_-]+)/?$ view.php?slug=$1 [L,QSA]

    # 4. Clean URLs for Built-in Legal Pages: /dmca, /disclaimer, /about-us, /privacy-policy
    RewriteRule ^(dmca|disclaimer|about-us|about|privacy-policy|privacy)/?$ view.php?slug=$1 [L,QSA,NC]

    # 5. Route custom login slug or unknown single-segment paths through index.php (if not an existing file or directory)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-zA-Z0-9_-]+)(?:\.php)?/?$ index.php?slug=$1 [L,QSA]

    # 6. Route any other non-existent deep path through index.php for unified error handling
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L,QSA]
</IfModule>

# Protect sensitive configuration, database, backup, and log files
<FilesMatch "^(config\.php|config\.local\.php|\.maintenance|composer\.(json|lock)|package(-lock)?\.json|.*\.(sql|sqlite|db|log|bak|sh|py|md|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
