{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "includeFiles": "api/**,public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/download-plugin-zip",
      "destination": "/api/download_plugin_zip"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
